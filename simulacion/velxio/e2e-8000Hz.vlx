{
  "format": "velxio-project",
  "version": 1,
  "exportedAt": "2026-10-22T17:40:00Z",
  "name": "EQ03 integrado - filtros ADC LED - 8000 Hz",
  "boards": [
    {
      "id": "esp32",
      "name": "ESP32 - ADC y barras",
      "boardKind": "esp32",
      "x": 1500,
      "y": 150,
      "activeFileGroupId": "group-esp32",
      "languageMode": "arduino",
      "serialBaudRate": 115200,
      "libraries": [
        "Adafruit NeoPixel"
      ]
    }
  ],
  "fileGroups": {
    "group-esp32": [
      {
        "name": "sketch.ino",
        "content": "#include <Adafruit_NeoPixel.h>\n#include <math.h>\nAdafruit_NeoPixel leds(12,25,NEO_GRB+NEO_KHZ800);\nconst int pins[3]={34,35,32};\nvoid setup(){Serial.begin(115200);leds.begin();leds.setBrightness(32);analogReadResolution(12);analogSetAttenuation(ADC_11db);for(int p:pins)pinMode(p,INPUT);}\nvoid loop(){\n double sum[3]={},sq[3]={};int n=2048;\n for(int i=0;i<n;i++){for(int k=0;k<3;k++){double v=analogRead(pins[k]);sum[k]+=v;sq[k]+=v*v;}delayMicroseconds(37);}\n float rms[3];int dominant=0;\n for(int k=0;k<3;k++){rms[k]=sqrt(fmax(0,sq[k]/n-pow(sum[k]/n,2)));if(rms[k]>rms[dominant])dominant=k;}\n for(int k=0;k<3;k++){int bars=constrain(lround(rms[k]/20),0,4);for(int j=0;j<4;j++){uint32_t c=k==0?leds.Color(255,100,0):k==1?leds.Color(0,255,60):leds.Color(0,180,255);leds.setPixelColor(k*4+j,j<bars?c:0);}}\n leds.show();Serial.printf(\"E2E RMS_ADC G=%.2f M=%.2f A=%.2f DOM=%d\\n\",rms[0],rms[1],rms[2],dominant);Serial.printf(\"MEAN %.0f %.0f %.0f\\n\",sum[0]/n,sum[1]/n,sum[2]/n);delay(80);\n}\n"
      }
    ]
  },
